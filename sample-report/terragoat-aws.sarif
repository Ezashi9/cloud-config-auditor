{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "cloud-config-auditor",
          "informationUri": "https://github.com/Ezashi9/cloud-config-auditor",
          "rules": [
            {
              "id": "CCA-001",
              "name": "Hard-codedAWSaccesskeys",
              "shortDescription": {
                "text": "Hard-coded AWS access keys"
              },
              "fullDescription": {
                "text": "Anyone who can read the code (or its history) can use the keys to act as you in AWS."
              },
              "help": {
                "text": "Delete the keys, rotate them immediately, and use IAM roles or a secrets manager instead."
              },
              "properties": {
                "security-severity": "9.5"
              }
            },
            {
              "id": "CCA-002",
              "name": "Hard-codeddatabasepassword",
              "shortDescription": {
                "text": "Hard-coded database password"
              },
              "fullDescription": {
                "text": "The password ends up in version control and the Terraform state file."
              },
              "help": {
                "text": "Generate it with a secrets manager (e.g. AWS Secrets Manager, or manage_master_user_password) and reference it."
              },
              "properties": {
                "security-severity": "8.0"
              }
            },
            {
              "id": "CCA-003",
              "name": "SecretsinLambdaenvironmentvariables",
              "shortDescription": {
                "text": "Secrets in Lambda environment variables"
              },
              "fullDescription": {
                "text": "Environment variables are visible to anyone with read access to the function configuration."
              },
              "help": {
                "text": "Store the secret in Secrets Manager or SSM Parameter Store and fetch it at runtime."
              },
              "properties": {
                "security-severity": "8.0"
              }
            },
            {
              "id": "CCA-004",
              "name": "SecretsinEC2userdata",
              "shortDescription": {
                "text": "Secrets in EC2 user data"
              },
              "fullDescription": {
                "text": "User data is readable from the instance metadata service and the AWS console."
              },
              "help": {
                "text": "Fetch secrets at boot from Secrets Manager using the instance's IAM role."
              },
              "properties": {
                "security-severity": "8.0"
              }
            },
            {
              "id": "CCA-010",
              "name": "Adminportopentotheinternet",
              "shortDescription": {
                "text": "Admin port open to the internet"
              },
              "fullDescription": {
                "text": "SSH and RDP exposed to the world are hit by constant brute-force attacks (see Log Hunter)."
              },
              "help": {
                "text": "Allow only known IP ranges, or remove the port and use AWS Systems Manager Session Manager."
              },
              "properties": {
                "security-severity": "8.0"
              }
            },
            {
              "id": "CCA-011",
              "name": "Databaseportopentotheinternet",
              "shortDescription": {
                "text": "Database port open to the internet"
              },
              "fullDescription": {
                "text": "Databases should never be directly reachable from the internet."
              },
              "help": {
                "text": "Allow the port only from the application's security group."
              },
              "properties": {
                "security-severity": "8.0"
              }
            },
            {
              "id": "CCA-012",
              "name": "Allportsopentotheinternet",
              "shortDescription": {
                "text": "All ports open to the internet"
              },
              "fullDescription": {
                "text": "Every service on the machine becomes reachable by anyone."
              },
              "help": {
                "text": "List only the ports the service needs, from the sources that need them."
              },
              "properties": {
                "security-severity": "8.0"
              }
            },
            {
              "id": "CCA-020",
              "name": "PublicS3bucketACL",
              "shortDescription": {
                "text": "Public S3 bucket ACL"
              },
              "fullDescription": {
                "text": "Public buckets are one of the most common causes of cloud data leaks."
              },
              "help": {
                "text": "Set the ACL to private and turn on S3 Block Public Access."
              },
              "properties": {
                "security-severity": "8.0"
              }
            },
            {
              "id": "CCA-021",
              "name": "S3BlockPublicAccessnotconfigured",
              "shortDescription": {
                "text": "S3 Block Public Access not configured"
              },
              "fullDescription": {
                "text": "Without it, one mistaken ACL or bucket policy can make data public."
              },
              "help": {
                "text": "Add aws_s3_bucket_public_access_block with all four settings true."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CCA-022",
              "name": "S3versioningdisabled",
              "shortDescription": {
                "text": "S3 versioning disabled"
              },
              "fullDescription": {
                "text": "Deleted or overwritten objects can't be recovered after a mistake or ransomware."
              },
              "help": {
                "text": "Enable versioning (aws_s3_bucket_versioning)."
              },
              "properties": {
                "security-severity": "3.0"
              }
            },
            {
              "id": "CCA-023",
              "name": "S3accessloggingdisabled",
              "shortDescription": {
                "text": "S3 access logging disabled"
              },
              "fullDescription": {
                "text": "Without logs you can't investigate who accessed data during an incident."
              },
              "help": {
                "text": "Enable server access logging to a separate log bucket."
              },
              "properties": {
                "security-severity": "3.0"
              }
            },
            {
              "id": "CCA-024",
              "name": "S3bucketwithoutacustomer-managedKMSkey",
              "shortDescription": {
                "text": "S3 bucket without a customer-managed KMS key"
              },
              "fullDescription": {
                "text": "AWS encrypts new objects by default (since January 2023), but a KMS key adds access control and an audit trail on the key."
              },
              "help": {
                "text": "Configure default encryption with sse_algorithm = aws:kms and your own key."
              },
              "properties": {
                "security-severity": "3.0"
              }
            },
            {
              "id": "CCA-030",
              "name": "Databasepubliclyaccessible",
              "shortDescription": {
                "text": "Database publicly accessible"
              },
              "fullDescription": {
                "text": "Puts the database directly on the internet, one weak password away from a breach."
              },
              "help": {
                "text": "Set publicly_accessible = false and reach it through the application or a bastion."
              },
              "properties": {
                "security-severity": "8.0"
              }
            },
            {
              "id": "CCA-031",
              "name": "Databasestoragenotencrypted",
              "shortDescription": {
                "text": "Database storage not encrypted"
              },
              "fullDescription": {
                "text": "Snapshots, backups and disks expose data in plain form if copied."
              },
              "help": {
                "text": "Set storage_encrypted = true (ideally with your own KMS key)."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CCA-032",
              "name": "Databasebackupsdisabled",
              "shortDescription": {
                "text": "Database backups disabled"
              },
              "fullDescription": {
                "text": "No automated backups means no recovery after deletion, corruption or ransomware."
              },
              "help": {
                "text": "Set backup_retention_period to at least 7 days."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CCA-040",
              "name": "EBSvolumenotencrypted",
              "shortDescription": {
                "text": "EBS volume not encrypted"
              },
              "fullDescription": {
                "text": "Unencrypted disks and their snapshots expose data if copied or shared."
              },
              "help": {
                "text": "Set encrypted = true, or turn on EBS encryption by default for the account."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CCA-041",
              "name": "Snapshotofanunencryptedvolume",
              "shortDescription": {
                "text": "Snapshot of an unencrypted volume"
              },
              "fullDescription": {
                "text": "The snapshot inherits the lack of encryption and is easy to share by mistake."
              },
              "help": {
                "text": "Encrypt the source volume, or copy the snapshot with encryption on."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CCA-042",
              "name": "InstancemetadataallowsIMDSv1",
              "shortDescription": {
                "text": "Instance metadata allows IMDSv1"
              },
              "fullDescription": {
                "text": "IMDSv1 lets server-side request forgery (SSRF) bugs read the instance's temporary AWS credentials."
              },
              "help": {
                "text": "Set metadata_options { http_tokens = \"required\" } to enforce IMDSv2."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CCA-050",
              "name": "Over-broadIAMpolicy",
              "shortDescription": {
                "text": "Over-broad IAM policy"
              },
              "fullDescription": {
                "text": "Wildcard permissions break least privilege: one stolen credential can do almost anything."
              },
              "help": {
                "text": "List only the specific actions and resources the role needs."
              },
              "properties": {
                "security-severity": "8.0"
              }
            },
            {
              "id": "CCA-051",
              "name": "IAMpolicyattacheddirectlytoauser",
              "shortDescription": {
                "text": "IAM policy attached directly to a user"
              },
              "fullDescription": {
                "text": "Per-user permissions are hard to review and are often forgotten when people leave."
              },
              "help": {
                "text": "Attach policies to groups or roles and put users in groups."
              },
              "properties": {
                "security-severity": "3.0"
              }
            },
            {
              "id": "CCA-052",
              "name": "Long-livedIAMaccesskeyinTerraform",
              "shortDescription": {
                "text": "Long-lived IAM access key in Terraform"
              },
              "fullDescription": {
                "text": "The secret key is written to the Terraform state file in plain text."
              },
              "help": {
                "text": "Use IAM roles or AWS IAM Identity Center (SSO) instead of access keys."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CCA-060",
              "name": "KMSkeyrotationdisabled",
              "shortDescription": {
                "text": "KMS key rotation disabled"
              },
              "fullDescription": {
                "text": "Long-lived keys increase the damage if a key is ever exposed."
              },
              "help": {
                "text": "Set enable_key_rotation = true."
              },
              "properties": {
                "security-severity": "3.0"
              }
            },
            {
              "id": "CCA-061",
              "name": "Searchdomainnotencryptedatrest",
              "shortDescription": {
                "text": "Search domain not encrypted at rest"
              },
              "fullDescription": {
                "text": "Indexed data (often logs or customer records) is stored unencrypted."
              },
              "help": {
                "text": "Enable encrypt_at_rest."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CCA-062",
              "name": "LoadbalancerwithoutTLS",
              "shortDescription": {
                "text": "Load balancer without TLS"
              },
              "fullDescription": {
                "text": "Traffic between users and the service can be read or altered in transit."
              },
              "help": {
                "text": "Use an HTTPS/TLS listener with an ACM certificate and redirect HTTP to HTTPS."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CCA-063",
              "name": "KubernetesAPIendpointpublic",
              "shortDescription": {
                "text": "Kubernetes API endpoint public"
              },
              "fullDescription": {
                "text": "Exposes the cluster's control plane to the whole internet."
              },
              "help": {
                "text": "Set endpoint_public_access = false, or restrict public_access_cidrs."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CCA-064",
              "name": "Weakcontainerregistrysettings",
              "shortDescription": {
                "text": "Weak container registry settings"
              },
              "fullDescription": {
                "text": "Mutable tags and no scanning make it easier to ship a tampered or vulnerable image."
              },
              "help": {
                "text": "Set image_tag_mutability = IMMUTABLE and scan_on_push = true."
              },
              "properties": {
                "security-severity": "3.0"
              }
            }
          ]
        }
      },
